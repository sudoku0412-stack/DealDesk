# Public site URL (metadata, Open Graph, canonical, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://dealdesk.craftloop.ca

# Supabase (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (confirmation emails)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="DealDesk <hello@craftloop.ca>"
